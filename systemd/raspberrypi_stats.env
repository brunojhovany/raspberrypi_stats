# Environment configuration for raspberrypi_stats
# Add environment variables as needed

# Example: Set the display refresh interval (in seconds)
REFRESH_INTERVAL=5

# Example: Set a custom log file path
LOG_PATH=/var/log/raspberrypi_stats.log

# In Python puedes acceder así:
# import os
# refresh = int(os.getenv('REFRESH_INTERVAL', 5))
# log_path = os.getenv('LOG_PATH', '/tmp/raspberrypi_stats.log')

# En C++ puedes acceder así:
# const char* refresh = getenv("REFRESH_INTERVAL");
# const char* log_path = getenv("LOG_PATH");

# --- raspberrypi_stats_cpp (C++) -------------------------------------------
# Every variable is optional; the values below are the defaults.

# Log interval in seconds
#RPI_STATS_LOG_INTERVAL=30

# Layout: classic | eva (Evangelion style) | cycle (alternate both)
#RPI_STATS_VIEW=classic
# Seconds per view when RPI_STATS_VIEW=cycle
#RPI_STATS_CYCLE_SECS=10

# Under-voltage alert (from vcgencmd get_throttled)
# Seconds the alert screen stays after the flag clears
#RPI_STATS_UV_HOLD=10
# 0 = do not blink the alert screen
#RPI_STATS_UV_BLINK=1

# Burn-in protection
# Normal brightness 1..255 (alerts always use 255)
#RPI_STATS_CONTRAST=0x20
# Panel off during this window ("off" disables); alerts wake it up
#RPI_STATS_SLEEP=23:00-07:00
# Screensaver after N s of metrics (0 disables); peek at the metrics
# for SAVER_PEEK s of every SAVER_PERIOD s
#RPI_STATS_SAVER_AFTER=300
#RPI_STATS_SAVER_PERIOD=60
#RPI_STATS_SAVER_PEEK=10
#RPI_STATS_SAVER_FPS=8
# Vertical pixel shift every 2 min (0 disables)
#RPI_STATS_SHIFT=1

# Testing only: simulate a get_throttled value, e.g. 0x50005
#RPI_STATS_FAKE_THROTTLED=
